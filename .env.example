# Copy to .env.local for development; set the same names in Vercel for
# production. Names only -- never commit values. See BACKEND_SETUP.md.

# --- Supabase (required in production) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional newer-style publishable key; used instead of the anon key when set.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Without it production forms refuse submissions (no fake receipts).
SUPABASE_SERVICE_ROLE_KEY=

# --- Signing secrets (required in production; long random strings) ---
# Signs checkout snapshots and order confirmation links. Checkout returns 500 without it.
CHECKOUT_TOKEN_SECRET=
# Signs session/pending-signup cookies.
AUTH_COOKIE_SECRET=
# Bearer secret for scheduled routes (/api/lifecycle/dispatch, /api/inventory/revalidate,
# /api/payments/safety). Must match private.app_config.cron_secret.
CRON_SECRET=

# --- Site ---
# Canonical origin, e.g. https://www.summithvacsupply.com
NEXT_PUBLIC_SITE_URL=

# --- Stripe (test keys locally: sk_test_ / pk_test_) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM="Summit HVAC Supply <orders@summithvacsupply.com>"
OPS_ALERT_EMAIL=

# --- ShipStation Custom Store ---
SHIPSTATION_STORE_USERNAME=
SHIPSTATION_STORE_PASSWORD=

# --- AI assistant (optional; without it /api/chat answers with the phone handoff) ---
ANTHROPIC_API_KEY=

# --- Ads (optional; "true" loads ad tags after consent and widens the CSP) ---
ADS_ENABLED=

# --- Development only (never set in production) ---
# ALLOW_UNAUTHENTICATED_ADMIN=true   # /admin with fictional data, dev only
# SHOW_PLACEHOLDER_REVIEWS=true      # demo reviews; illegal to publish as real
